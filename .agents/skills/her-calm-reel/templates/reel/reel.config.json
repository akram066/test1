    },
    {
      "id": "things",
      "text": "The dishes, the emails, the texts you haven't answered."
    },
    {
      "id": "tonight",
      "text": "You don't have to finish it tonight."
    },
    {
      "id": "small",
      "text": "Just do one small thing."
    },
    {
      "id": "water",
      "text": "Fill a glass of water."
    },
    {
      "id": "window",
      "text": "Open the window for a minute."
    },
    {
      "id": "breath",
      "text": "Take one slow breath."
    },
    {
      "id": "rest",
      "text": "Rest isn't something you earn."
    },
    {
      "id": "going",
      "text": "It's part of how you keep going."
    },
    {
      "id": "gentle",
      "text": "So be gentle with yourself today."
    },
    {
      "id": "cta",
      "text": "Follow for more gentle reminders."
    }
